-- Infinite loading animation
task.spawn(function()
    local i = 1

    while true do
        status.Text = messages[i]

        for dots = 0, 3 do
            status.Text = messages[i] .. string.rep(".", dots)
            task.wait(0.35)
        end

        i += 1
        if i > #messages then
            i = 1
        end
    end
end)
